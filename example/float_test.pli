FLOAT_TEST: PROCEDURE OPTIONS(MAIN);

   DECLARE RADIUS FLOAT BINARY;
   DECLARE PI FLOAT BINARY;
   DECLARE AREA FLOAT BINARY;
   DECLARE CIRCUMFERENCE FLOAT BINARY;
   DECLARE VALUES(3) FLOAT BINARY;
   DECLARE I FIXED BINARY;

   /* 1. Floating-Point Literals & Assignments */
   PI = 3.14159;
   RADIUS = 5.5;

   PUT SKIP LIST('=== PHASE 1 SSE FLOAT TEST ===');
   PUT SKIP LIST('PI:');
   PUT LIST(PI);
   PUT SKIP LIST('RADIUS:');
   PUT LIST(RADIUS);

   /* 2. SSE Double-Precision Arithmetic (+, *, /) */
   AREA = PI * (RADIUS * RADIUS);
   CIRCUMFERENCE = 2.0 * PI * RADIUS;

   PUT SKIP LIST('CALCULATED AREA:');
   PUT LIST(AREA);
   PUT SKIP LIST('CALCULATED CIRCUMFERENCE:');
   PUT LIST(CIRCUMFERENCE);

   /* 3. Floating-Point Comparisons (ucomisd) */
   IF AREA > 50.0 THEN
      PUT SKIP LIST('AREA TEST: PASSED (AREA > 50.0)');
   ELSE
      PUT SKIP LIST('AREA TEST: FAILED');

   /* 4. Floating-Point Arrays */
   VALUES(1) = 1.25;
   VALUES(2) = 2.50;
   VALUES(3) = VALUES(1) + VALUES(2);

   PUT SKIP LIST('ARRAY SUM (1.25 + 2.50):');
   PUT LIST(VALUES(3));

   /* 5. Subprocedure Pass-by-Reference with Float Updates */
   CALL SCALE_VALUE(VALUES(3), 2.0);
   PUT SKIP LIST('SCALED VALUE (3.75 * 2.0):');
   PUT LIST(VALUES(3));

   SCALE_VALUE: PROCEDURE(VAL_REF, FACTOR);
      DECLARE VAL_REF FLOAT BINARY;
      DECLARE FACTOR FLOAT BINARY;
      VAL_REF = VAL_REF * FACTOR;
   END SCALE_VALUE;

END FLOAT_TEST;
